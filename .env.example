# GoalSpace environment configuration
# Copy this file to .env and fill in your real values. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=futsal_booking

# --- Mail / SMTP ---
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=GoalSpace
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Google Sign-In (OAuth 2.0) ---
# Create OAuth client credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/futsal/auth/google_callback.php

# --- eSewa Payment Gateway ---
# mode: test | live
ESEWA_MODE=test
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
# Test eSewa user for trialing the checkout
ESEWA_TEST_EPAY_ID=9711111111
ESEWA_TEST_PASSWORD=Nepal@123
ESEWA_TEST_MPIN=1122
