# Block access to environment / dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Keep .php files under /config out of the web (they may hold no secrets now,
# but defense in depth)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config(/|$) - [F,L]
</IfModule>
