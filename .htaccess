# Block access to environment / dotfiles / secrets / backups
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(\.env.*|composer\.(json|lock)|database.*\.sql|.*\.docx?|prompt\.txt)$">
    Require all denied
</FilesMatch>

# Keep .php files under /config, /deploy, /tools out of the web (defense in depth).
# deploy/ and tools/ contain DB setup / diagnostics that must never run via HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config(/|$) - [F,L]
    RewriteRule ^deploy(/|$) - [F,L]
    RewriteRule ^tools/(migrate|system_check|send_reminders|auto_cancel_unpaid|apply_polish|migrate_webp)\.php$ - [F,L]
</IfModule>

# Block direct access to SQL dumps anywhere
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# Serve a dynamic XML sitemap (relative – works at domain root or /futsal/)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap.xml$ pages/sitemap.xml.php [L]
</IfModule>

# Serve styled error pages without leaking Apache defaults (relative paths)
ErrorDocument 403 /pages/403.php
ErrorDocument 404 /pages/404.php
ErrorDocument 500 /pages/500.php

# Far-future caching for versioned static assets (files are cache-busted with ?v=)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|webp|jpe?g|png|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Service worker and manifest must never be cached long-term, or app
    # updates (and install prompts) stop working.
    <FilesMatch "^(sw\.js|service-worker\.js|manifest\.json)$">
        Header unset Cache-Control
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
