# =====================================================================
# GoalSpace - configuration for InfinityFree
# Copy this file to ".env" on the server, then fill in the values from
# your InfinityFree control panel -> MySQL Databases.
# =====================================================================

# Your InfinityFree MySQL database (from Control Panel -> MySQL Databases)
# The host looks like: sqlXXX.infinityfree.com (port is 3306)
DB_HOST=sqlXXX.infinityfree.com
DB_USER=if0_XXXXX
DB_PASS=change_this_to_your_db_password
DB_NAME=if0_XXXXX_goalspace
DB_PORT=3306

# Set to "https" AFTER you enable the free SSL certificate in the
# InfinityFree control panel. This also forces all visitors onto HTTPS.
APP_SCHEME=https

# Leave empty when the site is uploaded to htdocs/ (domain root), which is
# what you want on InfinityFree. Only set this if you install in a subfolder.
BASE_PATH=

# Email note: InfinityFree's free plan blocks outbound SMTP, so emails
# cannot be sent. Leave SMTP_* blank: the app then shows verification codes
# on screen and relies on in-app notifications instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=goalspace.noreply@gmail.com
MAIL_FROM_NAME=GoalSpace

# Optional: Google OAuth sign-in (Continue with Google).
# Create credentials at https://console.cloud.google.com/ and add your
# domain to the authorized redirect URIs, then fill these in.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GOOGLE_REDIRECT_URI=https://your-site.infinityfreeapp.com/auth/google_callback.php
