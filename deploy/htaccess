# Block access to environment / dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "composer\.json">
    Require all denied
</FilesMatch>

# Keep .php files under /config out of the web
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config(/|$) - [F,L]
</IfModule>

# Serve a dynamic XML sitemap at /sitemap.xml
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^sitemap.xml$ pages/sitemap.xml.php [L]
</IfModule>

# Serve styled error pages without leaking Apache defaults
ErrorDocument 403 /pages/403.php
ErrorDocument 404 /pages/404.php
ErrorDocument 500 /pages/500.php

# Far-future caching for versioned static assets (files are cache-busted with ?v=)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|webp|jpe?g|png|gif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Service worker and manifest must never be cached long-term, or app
    # updates (and install prompts) stop working.
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header unset Cache-Control
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
